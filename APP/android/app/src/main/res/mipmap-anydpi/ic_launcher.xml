<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback icon for Android 5.0–7.x (API 21–25) where adaptive icons
     are not available. Uses a layer-list vector so no PNG is required. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C1502E"/>
        </shape>
    </item>
    <item
        android:top="20dp"
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
