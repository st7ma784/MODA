{
  "_comment": "Lancaster Heritage — canonical MODA brand tokens. Both FastMODA web and the Flutter APK derive their theme from these values.",
  "brand": "MODA / FastMODA",
  "institution": "Nonlinear & Biomedical Physics Group, Lancaster University",
  "palette": {
    "primary":      { "hex": "#C1502E", "name": "Terracotta",  "role": "Primary actions, brand accent, launcher background" },
    "primaryDark":  { "hex": "#A8412A", "name": "Terracotta Dark", "role": "Hover / active state for primary" },
    "secondary":    { "hex": "#E8932E", "name": "Amber",       "role": "Secondary actions, warnings, BLE-off state" },
    "highlight":    { "hex": "#F4C95D", "name": "Mustard",     "role": "Highlights, badges, fast-wave colour on icon" },
    "support":      { "hex": "#C97D74", "name": "Dusty Rose",  "role": "Supporting accent" },
    "success":      { "hex": "#7A9D54", "name": "Sage Green",  "role": "Connected / online / good-quality states" },
    "danger":       { "hex": "#B3261E", "name": "Deep Red",    "role": "Errors, disconnect, high-risk classifications" },
    "dangerDark":   { "hex": "#8F1D17", "name": "Deep Red Dark", "role": "Hover / active state for danger" }
  },
  "surfaces": {
    "background":   { "hex": "#221F1D", "name": "Dark Umber",      "role": "Scaffold / page background, splash screen" },
    "surface":      { "hex": "#2F2B28", "name": "Dark Warm Brown", "role": "Cards, bottom sheets" },
    "surfaceAlt":   { "hex": "#3A3530", "name": "Medium Warm Brown", "role": "Dropdown menus, alternate rows" },
    "webBg":        { "hex": "#FBFAF7", "name": "Warm White",      "role": "Web-only light-mode page background" },
    "webSurface":   { "hex": "#FFFFFF", "name": "White",           "role": "Web-only card background" },
    "webBgAlt":     { "hex": "#F4EFEA", "name": "Warm Cream",      "role": "Web-only subtle panels" },
    "webBorder":    { "hex": "#EAE3DC", "name": "Warm Border",     "role": "Web-only default border colour" }
  },
  "gradients": {
    "primary": "linear-gradient(135deg, #C1502E 0%, #E8932E 100%)",
    "note": "Terracotta → Amber. Used on primary action buttons (web analyze-btn, Android splash gradient)."
  },
  "typography": {
    "heading": {
      "family": "Poppins",
      "weights": [500, 600, 700],
      "source": "Google Fonts",
      "usage": "DisplayLarge → TitleSmall in Flutter; h1–h3 + card headers in web CSS"
    },
    "body": {
      "family": "Source Sans 3",
      "weights": [400, 600, 700],
      "source": "Google Fonts",
      "usage": "BodyLarge → LabelSmall in Flutter; body + form labels in web CSS"
    }
  },
  "logo": {
    "full":   "logo/moda-logo.svg",
    "banner": "logo/moda-banner.svg",
    "icon":   "logo/wave-icon.svg",
    "rasterPng": "logo/moda_logo.png",
    "iconDesign": "Two sine waves — a slow white wave (slow oscillation) riding beneath a fast mustard wave (fast oscillation), symbolising multiscale oscillatory dynamics."
  }
}
